{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title", // Keeps the "zdr" user name part, strips hostname automatically if needed or can be removed completely
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "break", // Adds a blank line for readability
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "locale",
    "break",
    "colors" // Keeps the cool color palette blocks at the bottom
  ]
}
