#!/bin/bash

# Only continue for interactive shells.
case $- in
    *i*) ;;
    *) return ;;
esac

# General bash/session settings.
# - History: ignore duplicates/space-prefixed commands and keep a longer log.
# - Prompt/dirs: trim long paths and make `cd` search common project roots.
# - Terminal: keep LINES/COLUMNS updated.
{{- $personalProjects := "~/Projects/Personal" }}
{{- if and (hasKey . "paths") (hasKey .paths "personalProjects") }}
{{- $personalProjects = .paths.personalProjects }}
{{- end }}
{{- $workProjects := "~/Projects/Work" }}
{{- if and (hasKey . "paths") (hasKey .paths "workProjects") }}
{{- $workProjects = .paths.workProjects }}
{{- end }}
HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=100000
PROMPT_DIRTRIM=2
CDPATH=.:~:{{ $personalProjects }}:{{ $workProjects }}
K8S_PROMPT_CONTEXT=""

shopt -s histappend
shopt -s checkwinsize

# Remap terminal freeze/XOFF to allow forward search in bash history.
# By default Ctrl+s is mappeed to XOFF with this remap Ctrl+p (pause) will
# freeze termional and Ctrl+q still unfreeeze it.
# Only run stty when stdin is a real terminal to avoid warnings while sourcing.
if [[ -t 0 ]]; then
    stty stop '^P'
fi

EDITOR=vim
VISUAL=vim

if command -v nvim >/dev/null 2>&1; then
    EDITOR=nvim
    VISUAL=nvim
    alias vim='nvim'
fi

export EDITOR VISUAL

prepend() {
    local dir
    for dir in "$@"; do
        [[ -n "$dir" && -d "$dir" ]] || continue
        case ":$PATH:" in
            *":$dir:"*) ;;
            *) PATH="$dir${PATH:+:$PATH}" ;;
        esac
    done
}

# Add local user binaries to PATH.
prepend "$HOME/.local/bin" "$HOME/bin"

{{- if eq .chezmoi.os "darwin" }}
# macOS/BSD `ls` colors.
export CLICOLOR=1
export LSCOLORS="GxFxCxDxBxegedabagaced"

# Set PATH for Homebrew using its default prefix.
if [[ -d /opt/homebrew ]]; then
    HOMEBREW_PREFIX=/opt/homebrew
elif [[ -d /usr/local/Homebrew || -x /usr/local/bin/brew ]]; then
    HOMEBREW_PREFIX=/usr/local
fi

if [[ -n ${HOMEBREW_PREFIX:-} ]]; then
    export HOMEBREW_PREFIX
    prepend "$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin"
fi

BREW_PREFIX="${HOMEBREW_PREFIX:-}"

# Prefer GNU command (like ls) instead of MacOS. Coreutils package need to be
# installed via brew first (brew install coreutils).
if [[ -n $BREW_PREFIX ]]; then
    prepend \
        "$BREW_PREFIX/opt/coreutils/libexec/gnubin" \
        "$BREW_PREFIX/opt/gnu-tar/libexec/gnubin"
fi
{{- end }}

# Set locales
# Clear LC_ALL before probing locales so subprocesses do not inherit an
# invalid override from the parent environment.
unset LC_ALL

declare -A AVAILABLE_LOCALES=()
while IFS= read -r locale_name; do
    locale_name="${locale_name,,}"
    locale_name="${locale_name//utf-8/utf8}"
    AVAILABLE_LOCALES["$locale_name"]=1
done < <(locale -a 2>/dev/null)

locale_available() {
    local requested
    requested="${1,,}"
    requested="${requested//utf-8/utf8}"

    [[ -n ${AVAILABLE_LOCALES["$requested"]:-} ]] && return 0

    return 1
}

set_first_available_locale() {
    local name="$1"
    shift

    local value
    for value in "$@"; do
        if locale_available "$value"; then
            export "$name=$value"
            return 0
        fi
    done

    return 1
}

# Keep programs in English, but prefer a UTF-8 locale that actually exists.
set_first_available_locale LANG en_US.UTF-8 C.UTF-8
export LANGUAGE=en_US:en

# Use English names with 24-hour / Monday-first conventions for time.
set_first_available_locale LC_TIME en_IE.UTF-8 en_GB.UTF-8
# Use Slovak regional formatting where it is helpful.
set_first_available_locale LC_MONETARY sk_SK.UTF-8
set_first_available_locale LC_NUMERIC sk_SK.UTF-8
set_first_available_locale LC_MEASUREMENT sk_SK.UTF-8
set_first_available_locale LC_PAPER sk_SK.UTF-8

# fzf magic
if command -v fzf >/dev/null 2>&1; then

  # fzf gruvbox theme
  export FZF_DEFAULT_OPTS="
    --color=bg:#282828,fg:#ebdbb2,hl:#fabd2f
    --color=bg+:#3c3836,fg+:#ebdbb2,hl+:#fabd2f
    --color=info:#83a598,prompt:#83a598,pointer:#fb4934
    --color=marker:#b8bb26,spinner:#fabd2f,header:#928374
  "

  # fzf history (Ctrl+R)
  fh() {
    local cmd
    cmd=$(history | sed 's/^ *[0-9]* *//' | awk '!seen[$0]++' | \
      fzf --tac --no-sort --reverse \
          --preview 'echo {}' \
          --preview-window=down:5:wrap)
    if [ -n "$cmd" ]; then
      READLINE_LINE="$cmd"
      READLINE_POINT=${#cmd}
    fi
  }

  bind -x '"\C-r": fh'

fi

# Prompt selection:
# - Prefer starship when it is installed.
# - Fall back to the native bash prompter otherwise.
if command -v starship >/dev/null 2>&1; then
    export STARSHIP_LOG=error
    eval "$(starship init bash)"
else
    PROMPT_COMMAND=prompter
fi

# Dynamic updater for PS1.
prompter() {
    local last_exit=$?

    # Colors http://misc.flogisoft.com/bash/tip_colors_and_formatting
    BOLD_GREEN="\e[1;32m"
    BOLD_YELLOW="\e[1;33m"
    BOLD_RED="\e[1;31m"
    # BOLD_WHITE="\e[1;37m"
    BOLD_BLUE="\e[1;34m"
    BOLD_PURPLE="\e[1;35m"
    # BOLD_CYAN="\e[1;36m"
    RESET_TEXT="\e[1;0m"

    local prompt_char_color="$BOLD_YELLOW"
    if [[ $last_exit -ne 0 ]]; then
        prompt_char_color="$BOLD_RED"
    fi

    PS1="\[$BOLD_GREEN\]@\h\[$BOLD_YELLOW\] \w\[$BOLD_BLUE\]\$(parse_git_branch)\[$BOLD_RED\]\$(parse_git_status)\[$BOLD_PURPLE\]\$(parse_k8s_context)\n\[$prompt_char_color\]➜ \[$RESET_TEXT\]"
}

# Helper function to set Git branch in shell prompt.
parse_git_branch() {
    local branch

    branch="$(git branch --show-current 2>/dev/null)"
    [[ -n $branch ]] && printf ' ⎇  %s' "$branch"
}

# Helper function to show lightweight Git status markers in the prompt.
parse_git_status() {
    local porcelain line ahead behind dirty untracked staged unmerged _

    # Porcelain v2 gives a stable, machine-readable status format plus
    # branch metadata (including ahead/behind counts) in one Git call.
    porcelain="$(git status --porcelain=2 --branch 2>/dev/null)" || return 0

    while IFS= read -r line; do
        case "$line" in
            '# branch.ab '*)
                # Example: "# branch.ab +2 -1" means 2 commits ahead, 1 behind.
                read -r _ _ ahead behind <<< "$line"
                ahead="${ahead#+}"
                behind="${behind#-}"
                ;;
            # "1 " = ordinary changed path, "2 " = renamed/copied path.
            '1 '*|'2 '*)
                # Porcelain v2 uses XY status codes for tracked files:
                # - X (line[2]) is the staged/index status
                # - Y (line[3]) is the unstaged/worktree status
                [[ ${line:2:1} != "." ]] && staged=1
                [[ ${line:3:1} != "." ]] && dirty=1
                ;;
            'u '*)
                # Unmerged/conflicted path.
                unmerged=1
                ;;
            '? '*)
                # Untracked path.
                untracked=1
                ;;
        esac
    done <<< "$porcelain"

    if [[ -n $ahead && -n $behind && $ahead != 0 && $behind != 0 ]]; then
        printf ' ⇕⇡%s⇣%s' "$ahead" "$behind"
    elif [[ -n $ahead && $ahead != 0 ]]; then
        printf ' ⇡%s' "$ahead"
    elif [[ -n $behind && $behind != 0 ]]; then
        printf ' ⇣%s' "$behind"
    fi

    if [[ -n $unmerged ]]; then
        printf ' [U]'
    elif [[ -n $staged || -n $dirty || -n $untracked ]]; then
        printf ' [!]'
    fi
}

# Helper function to set kubernetes context in shell prompt.
parse_k8s_context() {
    [[ -n $K8S_PROMPT_CONTEXT ]] && printf ' (k8s:%s)' "$K8S_PROMPT_CONTEXT"
}

# Some nice aliases to have
alias diff='diff --color'
alias g='git'
alias n='nvim'
alias sup='sudo -i'
alias ls='ls --color --group-directories-first'
alias ll='ls -lA'
# Optional modern replacements once you want them full-time.
# alias ls='eza --group-directories-first'
# alias ll='eza -la --group-directories-first'
# alias tree='eza --tree'
if command -v eza >/dev/null 2>&1; then
    alias l='eza --group-directories-first'
    alias la='eza -la --group-directories-first'
    alias lt='eza --tree --level=2 --group-directories-first'
fi
alias mc='mc -uX' # Disable X and subshell to start quick on Mac
# kubernetes
alias k='kubectl'

gcloc() {
    git ls-files -z | xargs -0 cloc
}

# Select from multiple k8s clusters configurations.
kc() {
    local k8s_config

    # Build list of kubeconfig files + add special "[default]" option
    k8s_config=$(
        {
            echo "[default]";
            find "$HOME"/.kube -type f -not -path "$HOME/.kube/old-config/*" \
                \( -iname '*.yaml' -o -iname '*.yml' -o -iname '*.conf' -o -iname '*.config' -o -iname '*.kube' \);
        } | fzf --prompt="Select kubeconfig > " --height=20% --border
    )

    # Handle user selection
    if [[ -z "$k8s_config" ]]; then
        echo "No selection. KUBECONFIG unchanged."
        return 1
    elif [[ "$k8s_config" == "[default]" ]]; then
        unset KUBECONFIG
        K8S_PROMPT_CONTEXT="default"
        echo "KUBECONFIG unset (using default ~/.kube/config)."
    else
        export KUBECONFIG="$k8s_config"
        K8S_PROMPT_CONTEXT="$(basename "$k8s_config")"
        echo "KUBECONFIG set to: $k8s_config"
    fi
}


glf() {
    git log --color=always \
        --format='%C(auto)%h%x09%C(yellow)%d%C(reset) %C(white)%s%C(reset) %C(green)(%cr) %C(blue)<%an>' | \
        fzf --ansi --no-sort --reverse --tiebreak=index \
            --delimiter=$'\t' --with-nth=2.. \
            --preview 'git show --color=always {1}' \
            --bind 'q:abort,enter:execute(git show --color=always {1} | less -R)' \
            --preview-window=right:60%
}

awsp() {
    AWS_PROFILE="$(aws configure list-profiles | fzf)"
    if [[ -z $AWS_PROFILE ]]; then
        echo "No selection. AWS_PROFILE unchanged."
        return 1
    fi

    export AWS_PROFILE
    echo "Switched to AWS profile '$AWS_PROFILE'."
}

{{- if not (and (hasKey . "shell") (hasKey .shell "enableZoxide") (eq .shell.enableZoxide false)) }}
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi
{{- end }}

{{- if not (and (hasKey . "shell") (hasKey .shell "enableFnm") (eq .shell.enableFnm false)) }}
if command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env --use-on-cd --shell bash)"
fi
{{- end }}

# Run manually after installing or upgrading tools that provide completions.
refresh-completions() {
    mkdir -p ~/.bash_completions

{{- if not (and (hasKey . "shell") (hasKey .shell "enableFnm") (eq .shell.enableFnm false)) }}
    if command -v fnm >/dev/null 2>&1; then
        fnm completions --shell bash > ~/.bash_completions/fnm.sh
    fi
{{- end }}

    if command -v npm >/dev/null 2>&1; then
        npm completion > ~/.bash_completions/npm.sh
    fi

    if command -v kubectl >/dev/null 2>&1; then
        kubectl completion bash > ~/.bash_completions/kubectl.sh
    fi

    if command -v uv >/dev/null 2>&1; then
        uv generate-shell-completion bash > ~/.bash_completions/uv.sh
    fi
}

# Python is managed with uv, which does not require shell init.

# Enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc or /etc/profile).
# If not sources particular file.
if ! shopt -oq posix; then
    # macOS system with Homebrew.
    if [ -n "$BREW_PREFIX" ] && [ -f "$BREW_PREFIX/etc/profile.d/bash_completion.sh" ]; then
        # shellcheck disable=SC1091
        LANG=C source "$BREW_PREFIX/etc/profile.d/bash_completion.sh"
    elif [ -f /usr/share/bash-completion/bash_completion ]; then
        # shellcheck disable=SC1091
        source /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        # shellcheck disable=SC1091
        source /etc/bash_completion
    fi
    # Load local bash autocompletion files.
    if [ -d ~/.bash_completions ]; then
        for f in ~/.bash_completions/*.sh; do
            [[ -e "$f" ]] || break  # handle the case of no *.sh files
            # shellcheck disable=SC1090
            . "$f"
        done
    fi
fi

if declare -F __start_kubectl >/dev/null 2>&1; then
    complete -F __start_kubectl k
fi

# Added by LM Studio CLI (lms)
prepend "$HOME/.lmstudio/bin"
# End of LM Studio CLI section

{{- if not (and (hasKey . "shell") (hasKey .shell "enableGoenv") (eq .shell.enableGoenv false)) }}
# Go toolchain management:
# - Keep toolchain selection local-only so missing versions fail loudly
#   instead of being downloaded automatically.
# - Keep goenv init at the end so its PATH/shims setup wins.
if command -v goenv >/dev/null 2>&1; then
    export GOTOOLCHAIN=local
    export GOENV_ROOT="$HOME/.goenv"
    prepend "$GOENV_ROOT/bin"
    eval "$(goenv init -)"
fi
{{- end }}
