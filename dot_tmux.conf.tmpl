##### Terminal / Colors #####

# Best practice for tmux ≥3.2
set -g default-terminal "tmux-256color"

# Truecolor support
set -as terminal-features ",*:RGB"

##### Performance / UX (optional improvements) #####

# Faster ESC handling (useful for vim)
set -sg escape-time 10

# Better key support (arrows, modifiers)
set -g xterm-keys on

# Use user shell consistently
set -g default-command "${SHELL}"

##### Indexing #####

set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

##### Clipboard #####

set -g set-clipboard on

{{- if eq .chezmoi.os "darwin" }}
set -g @copy_command "pbcopy"
{{- else }}
run-shell '
  if command -v wl-copy >/dev/null 2>&1; then
    tmux set -g @copy_command "wl-copy"
  elif command -v xclip >/dev/null 2>&1; then
    tmux set -g @copy_command "xclip -silent -in -selection clipboard"
  elif command -v xsel >/dev/null 2>&1; then
    tmux set -g @copy_command "xsel --clipboard --input"
  else
    tmux set -g @copy_command "cat >/dev/null"
  fi
'
{{- end }}

##### General #####

set -g mouse on
set -g allow-rename off
set -g automatic-rename off

##### Prefix #####

unbind C-b
set -g prefix C-a
bind C-a send-prefix
bind C-a last-window

##### Window / Pane #####

bind e set-window-option synchronize-panes
bind r source-file ~/.tmux.conf \; display "Reloaded"
bind c new-window -c "#{pane_current_path}"
bind s choose-tree -Zs
bind \; last-pane

bind-key S-Left swap-window -t -
bind-key S-Right swap-window -t +

# Maximize / restore pane
bind -r m resize-pane -Z

##### Navigation (optional) #####

# Vim-style pane movement without prefix
bind -n M-h select-pane -L
bind -n M-l select-pane -R
bind -n M-k select-pane -U
bind -n M-j select-pane -D

# Resize panes with Shift+Alt
bind -n S-M-h resize-pane -L 5
bind -n S-M-l resize-pane -R 5
bind -n S-M-k resize-pane -U 5
bind -n S-M-j resize-pane -D 5

##### Splitting (optional usability) #####

bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

##### Copy mode (vi) #####

setw -g mode-keys vi

bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi V send -X select-line
bind -T copy-mode-vi Enter send -X copy-pipe-and-cancel "#{@copy_command}"
bind -T copy-mode-vi y send -X copy-pipe-and-cancel "#{@copy_command}"
bind -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel "#{@copy_command}"

bind-key P choose-buffer

##### Cleanup #####

unbind-key -T root MouseDown3Pane
unbind -T copy-mode MouseDragEnd1Pane

##### Theme #####

source-file ~/.config/tmux/tmux.gruvbox.conf
